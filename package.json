{
  "name": "telesphoros-remastered",
  "private": true,
  "version": "0.0.0",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint && pnpm format:check",
    "format": "prettier --write \"{apps,packages}/*/{src,test}/**/*.{ts,tsx,mts,cts,js,mjs,cjs}\"",
    "format:check": "prettier --check \"{apps,packages}/*/{src,test}/**/*.{ts,tsx,mts,cts,js,mjs,cjs}\"",
    "typecheck": "node scripts/workspace-build/workspace.cjs run typecheck",
    "test": "node --test scripts/workspace-build/workspace.test.cjs scripts/workspace-build/versions.test.cjs scripts/lint/type-imports.test.mjs scripts/lint/prettier-scope.test.mjs scripts/local-storage/operations.test.cjs && node scripts/workspace-build/workspace.cjs run test",
    "build": "node scripts/workspace-build/workspace.cjs run build",
    "test:infra": "node --test infrastructure/terraform/guard.test.mjs",
    "test:ci-config": "node --test .github/ci/*.test.mjs",
    "status:index": "node scripts/status-index.mjs",
    "demo:review:setup": "node scripts/local-review/database.cjs setup",
    "demo:review": "node scripts/local-review/start.cjs",
    "demo:review:test": "node --test scripts/local-review/local-poppler-runner.test.cjs",
    "test:demo-seed": "node --test scripts/local-review/personas.test.cjs scripts/local-review/seed.test.cjs",
    "test:image": "node --test infrastructure/docker/guard.test.mjs",
    "demo:smart:setup": "pnpm --filter @telesphoros/smart-pilot ehr:start && pnpm --filter @telesphoros/smart-pilot ehr:configure",
    "demo:smart": "pnpm --filter @telesphoros/smart-pilot build && pnpm --filter @telesphoros/smart-pilot start",
    "test:build-orchestration": "node --test scripts/workspace-build/workspace.test.cjs",
    "demo:storage:build": "pnpm --filter @telesphoros/backend build && pnpm --filter @telesphoros/fake-idp build && VITE_LOCAL_STORAGE_INTAKE=true VITE_REPORT_STORAGE_ORIGINS=http://127.0.0.1:5557 pnpm --filter @telesphoros/frontend exec vite build --mode e2e --outDir dist-storage-e2e",
    "demo:storage": "node scripts/local-storage/start.cjs start",
    "demo:storage:teardown": "node scripts/local-storage/start.cjs teardown",
    "test:storage-ops": "node --test scripts/local-storage/operations.test.cjs",
    "test:launcher-cors": "node --test scripts/local-storage/launcher-cors.test.cjs",
    "test:storage-rehearsal": "node scripts/local-storage/rehearse.cjs",
    "test:storage-recovery": "node scripts/local-storage/recovery.cjs"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
