# Placeholders only. Real values live in AWS Secrets Manager, never in git.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Backend authentication (Phase 2: development/test verifier only).
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=telesphoros-dev
JWT_AUDIENCE=telesphoros-api

DATABASE_URL=postgres://user:password@localhost:5432/dbname
REDIS_URL=redis://localhost:6379
AWS_REGION=us-east-2
AWS_SECRET_NAME=
# PGx narration/model output stays OFF unless exactly 'true' (clinical sign-off required)
PGX_CLINICAL_HOLD_LIFTED=false
