# Placeholders only. Real values live in AWS Secrets Manager, never in git.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Backend authentication. hmac = development/tests only; cognito = the only one allowed in production.
AUTH_VERIFIER=hmac
# hmac only. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=telesphoros-dev
JWT_AUDIENCE=telesphoros-api
# cognito (values from the Terraform outputs):
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
# Browser origins allowed to call the API, comma separated (empty = none). https only in production.
CORS_ALLOWED_ORIGINS=

# Storage: memory (default, for quick tests) or postgres.
STORAGE_DRIVER=memory
# The APPLICATION login role (a member of telesphoros_app), never the owner/admin. Local dev role: see
# infrastructure/docker/postgres-init.sql
# The URL carries NO TLS parameters (no sslmode, sslrootcert, ...): they are refused at start-up. TLS comes only from DATABASE_SSL:
#   disable (default; local development and tests only)  |  require (TLS 1.2+, certificate chain and host name verified; required in production)
DATABASE_URL=
DATABASE_SSL=disable
# With DATABASE_SSL=require, the pg_dump/pg_restore tools verify the server against this authority file (falls back to NODE_EXTRA_CA_CERTS):
DATABASE_SSL_CA=
# Used only by the db:* CLI (migrations, backup, restore), never by the API:
DATABASE_MIGRATOR_URL=
DATABASE_ADMIN_URL=

# Report files: memory (default) or s3 (AWS S3, or MinIO via S3_ENDPOINT).
OBJECT_STORAGE_DRIVER=memory
REPORTS_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
DOWNLOAD_URL_TTL_SECONDS=120
# Synthetic, non-production lab-report pipeline. Off by default; refused in production and with the in-memory store.
LAB_REPORT_PIPELINE=disabled
# Medication POSTs are fenced until migration and compatible API/worker/verifier rollout are confirmed. Reads stay available.
MEDICATION_WRITES=disabled
# Required when LAB_REPORT_PIPELINE=enabled: a directory of recorded PDFs and their text for the TEST-ONLY text runner
# (for development, knowledge/lab-report-reader/v2-handoff/fixtures/captures). No default.
# LAB_REPORT_FIXTURES_DIR=
# Also required when the pipeline is enabled (no defaults): the knowledge directory to evaluate against (for development,
# data/fixtures/knowledge/test-only-reader) and the build version stored with every evaluation.
# KNOWLEDGE_DIR=
# BUILD_VERSION=
# At most this many reads of report text at once in this process (1 to 16).
# LAB_REPORT_MAX_CONCURRENT_READS=2
# The ledger watch (docs/ops/ledger-watch.md): the ledger VERIFIER's own login, never the application's. Required in production and when the
# pipeline is enabled; when unset elsewhere the watch is off. For development see docs/ops/ledger-roles.md.
# LEDGER_VERIFIER_DATABASE_URL=
# Time allowed, in total across tenants, for the checks at start (1000 to 300000), and hours between full walks (0 turns the timer off).
# LEDGER_STARTUP_BUDGET_MS=20000
# LEDGER_FULL_VERIFY_INTERVAL_HOURS=24
# Patient identity encryption (spec 025). Development and tests need nothing: a fixed, non-secret local key wraps each patient's data key. In production the
# AWS KMS key id is REQUIRED and a local key is REFUSED. Set at most one of the two. KMS_ENDPOINT points at an emulator (development only).
# PATIENT_FIELD_KMS_KEY_ID=
# PATIENT_FIELD_LOCAL_KEY=
# KMS_ENDPOINT=
# Rate limiting (docs/ops/rate-limiting.md). On by default; production refuses to start with it off.
# RATE_LIMIT_ENABLED=true
# Requests per minute: per client address (before sign-in), and per person for reads, writes and expensive routes.
# RATE_LIMIT_IP_PER_MINUTE=300
# RATE_LIMIT_READ_PER_MINUTE=120
# RATE_LIMIT_WRITE_PER_MINUTE=30
# RATE_LIMIT_EXPENSIVE_PER_MINUTE=10
# How many reverse proxies sit in front of the API (0 to 5). Production refuses to start unless this is set: 0 if nothing is in front,
# 1 behind one load balancer. Wrong values defeat or poison the address limit.
# TRUST_PROXY_HOPS=
REDIS_URL=redis://localhost:6379
AWS_REGION=us-east-2
AWS_SECRET_NAME=
# PGx narration/model output stays OFF unless exactly 'true' (clinical sign-off required)
PGX_CLINICAL_HOLD_LIFTED=false
