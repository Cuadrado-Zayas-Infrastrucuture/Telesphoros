# Placeholders only. Real values live in AWS Secrets Manager, never in git.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Backend authentication. hmac = development/tests only; cognito = the only one allowed in production.
AUTH_VERIFIER=hmac
# hmac only. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=telesphoros-dev
JWT_AUDIENCE=telesphoros-api
# cognito (values from the Terraform outputs):
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
# Browser origins allowed to call the API, comma separated (empty = none). https only in production.
CORS_ALLOWED_ORIGINS=

# Storage: memory (default, for quick tests) or postgres.
STORAGE_DRIVER=memory
# The APPLICATION login role (a member of telesphoros_app), never the owner/admin. Local dev role: see
# infrastructure/docker/postgres-init.sql
DATABASE_URL=
DATABASE_SSL=disable
# Used only by the db:* CLI (migrations, backup, restore), never by the API:
DATABASE_MIGRATOR_URL=
DATABASE_ADMIN_URL=

# Report files: memory (default) or s3 (AWS S3, or MinIO via S3_ENDPOINT).
OBJECT_STORAGE_DRIVER=memory
REPORTS_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
UPLOAD_URL_TTL_SECONDS=300
REDIS_URL=redis://localhost:6379
AWS_REGION=us-east-2
AWS_SECRET_NAME=
# PGx narration/model output stays OFF unless exactly 'true' (clinical sign-off required)
PGX_CLINICAL_HOLD_LIFTED=false
