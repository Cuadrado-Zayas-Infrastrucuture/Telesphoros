{
  "name": "@telesphoros/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test scripts/check-branding.test.mjs scripts/vercel-preview.test.mjs && vitest run",
    "check:chunks": "node scripts/check-chunks.mjs && node scripts/check-foundation.mjs",
    "e2e": "pnpm --filter @telesphoros/fake-idp build && pnpm --filter @telesphoros/backend build && VITE_REPORT_STORAGE_ORIGINS=http://127.0.0.1:5557 vite build --mode e2e --outDir dist-e2e && playwright test && playwright test --config playwright.local.config.ts && playwright test --config playwright.owned-local.config.ts",
    "build:e2e": "VITE_REPORT_STORAGE_ORIGINS=http://127.0.0.1:5557 vite build --mode e2e --outDir dist-e2e",
    "e2e:storage": "pnpm --filter @telesphoros/fake-idp build && pnpm --filter @telesphoros/backend build && VITE_LOCAL_STORAGE_INTAKE=true VITE_REPORT_STORAGE_ORIGINS=http://127.0.0.1:5557 vite build --mode e2e --outDir dist-storage-e2e && playwright test --config playwright.storage.config.ts",
    "check:brand": "node scripts/check-branding.mjs",
    "test:brand": "node --test scripts/check-branding.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.147",
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@telesphoros/shared-types": "workspace:*",
    "ai": "7.0.143",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@telesphoros/fake-idp": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-imagetools": "^12.0.1",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  }
}
