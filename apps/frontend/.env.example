# Build-time settings (Vite). None of these is secret: they are visible to every visitor.
# From the Terraform outputs (infrastructure/terraform):
VITE_OIDC_AUTHORITY=https://cognito-idp.us-east-2.amazonaws.com/us-east-2_XXXXXXXXX
VITE_OIDC_CLIENT_ID=
VITE_COGNITO_DOMAIN=https://your-prefix.auth.us-east-2.amazoncognito.com
# Where the API lives (it must list this site's origin in CORS_ALLOWED_ORIGINS):
VITE_API_BASE_URL=https://api.telesphoros.app
