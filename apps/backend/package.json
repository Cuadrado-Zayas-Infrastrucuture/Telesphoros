{
  "name": "@telesphoros/backend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "prebuild": "node ../../scripts/workspace-build/workspace.cjs prepare shared-types cpic-schema jobs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:evaluation-worker": "node dist/evaluation-worker.js",
    "pretypecheck": "node ../../scripts/workspace-build/workspace.cjs prepare shared-types cpic-schema fake-idp jobs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:db": "TEST_STORAGE=postgres jest",
    "test:fixture-lifecycle": "node --test ../../scripts/test-fixtures/lifecycle.test.cjs",
    "db:migrate": "node dist/db/cli.js migrate up",
    "db:migrate:down": "node dist/db/cli.js migrate down",
    "db:status": "node dist/db/cli.js migrate status",
    "db:keygen": "node dist/db/cli.js keygen",
    "db:backup": "node dist/db/cli.js backup",
    "db:restore": "node dist/db/cli.js restore",
    "knowledge:verify": "node dist/services/knowledge/cli.js verify",
    "knowledge:hash": "node dist/services/knowledge/cli.js hash",
    "knowledge:locate": "node dist/services/knowledge/cli.js locate"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1153.0",
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/client-secrets-manager": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@telesphoros/cpic-schema": "workspace:*",
    "@telesphoros/jobs": "workspace:*",
    "@telesphoros/shared-types": "workspace:*",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.2.0",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@telesphoros/fake-idp": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
