{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2024"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "durable",
    "test",
    "tsup.config.ts",
    "vitest.config.mts",
    "vitest.durable.config.mts"
  ]
}
