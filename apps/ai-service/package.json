{
  "name": "@telesphoros/ai-service",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node ../../scripts/workspace-build/workspace.cjs prepare jobs",
    "build": "tsup",
    "pretypecheck": "node ../../scripts/workspace-build/workspace.cjs prepare jobs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "node ../../scripts/workspace-build/workspace.cjs prepare jobs",
    "test": "vitest run",
    "test:durable:pg": "node ../../scripts/workspace-build/workspace.cjs prepare jobs && vitest run --config vitest.durable.config.mts"
  },
  "dependencies": {
    "@telesphoros/jobs": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "@types/node": "^26.6.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "eslint": "^10.12.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.71.1",
    "globals": "^17.13.0"
  },
  "description": "Synthetic control-flow library only; no models, service, effects or deployment"
}
