{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform -chdir=* apply*)",
      "Bash(terraform -chdir=* destroy*)",
      "Bash(tofu apply*)",
      "Bash(tofu destroy*)",
      "Bash(tofu -chdir=* apply*)",
      "Bash(tofu -chdir=* destroy*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(gh api -X PUT *rulesets*)",
      "Bash(gh api -X POST *rulesets*)",
      "Bash(gh api -X PATCH *rulesets*)",
      "Bash(gh api -X DELETE *rulesets*)",
      "Bash(gh api --method PUT *rulesets*)",
      "Bash(gh api --method POST *rulesets*)",
      "Bash(gh api --method PATCH *rulesets*)",
      "Bash(gh api --method DELETE *rulesets*)"
    ]
  }
}
