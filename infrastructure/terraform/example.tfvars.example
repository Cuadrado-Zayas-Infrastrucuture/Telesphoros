environment = "staging"

vpc_id                 = "vpc-0123456789abcdef0"
private_subnet_ids     = ["subnet-0aaaaaaaaaaaaaaaa", "subnet-0bbbbbbbbbbbbbbbb"]
app_security_group_ids = ["sg-0123456789abcdef0"]

reports_cors_origins = ["https://app.telesphoros.app"]

# Production must also set:
# db_multi_az = true

# Authentication
app_callback_urls     = ["https://app.telesphoros.app/auth/callback"]
app_logout_urls       = ["https://app.telesphoros.app/signed-out"]
cognito_domain_prefix = "telesphoros-staging"
ses_from_email        = "no-reply@telesphoros.app"
