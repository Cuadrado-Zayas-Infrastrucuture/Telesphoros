environment = "staging"

# Deployment profile (README.md, "Deployment profiles"). The default, production, is what is written for; do not change it for anything that will hold real records.
# For the FD-7 rehearsal only (staging, synthetic data, one Region, small, destroyable, creates its own network), set the following and delete the vpc_id and subnet lines below:
# deployment_profile = "synthetic"

# Production profile: required. Synthetic profile: leave both out and the rehearsal creates its own network.
vpc_id                 = "vpc-0123456789abcdef0"
private_subnet_ids     = ["subnet-0aaaaaaaaaaaaaaaa", "subnet-0bbbbbbbbbbbbbbbb"]
app_security_group_ids = ["sg-0123456789abcdef0"]

reports_cors_origins = ["https://app.telesphoros.app"]

# Production must also set:
# db_multi_az = true

# Authentication
app_callback_urls     = ["https://app.telesphoros.app/auth/callback"]
app_logout_urls       = ["https://app.telesphoros.app/signed-out"]
cognito_domain_prefix = "telesphoros-staging"
ses_from_email        = "no-reply@telesphoros.app"

# API hosting (docs/ops/api-hosting.md). Off by default. With it on, app_security_group_ids may be empty (the API tasks'
# own group is then the one the database accepts).
# enable_api_hosting = true
# public_subnet_ids  = ["subnet-0cccccccccccccccc", "subnet-0dddddddddddddddd"]

# API compute (F3b; needs enable_api_hosting). The image is pinned by digest and comes from F4; leave it empty to create only the foundations.
# api_image         = "123456789012.dkr.ecr.us-east-2.amazonaws.com/telesphoros-api@sha256:<64 hex digits>"
# api_cors_origins  = ["https://app.telesphoros.app"]   # staging: the Vercel staging address
# api_desired_count = 2                                 # production needs at least 2

# Audit trail (docs/ops/audit-trail.md). The alarm address has no default: SNS emails it a confirmation link.
alarm_email = "security@example.com"
# audit_lock_mode = "GOVERNANCE"   # COMPLIANCE is irreversible; decide separately
# audit_lock_days = 365
