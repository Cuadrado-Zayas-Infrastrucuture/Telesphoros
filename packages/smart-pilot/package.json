{
  "name": "@telesphoros/smart-pilot",
  "private": true,
  "version": "0.0.0",
  "description": "LOCAL SYNTHETIC ONLY: isolated OpenEMR SMART integration rehearsal",
  "type": "module",
  "scripts": {
    "pretypecheck": "node ../../scripts/workspace-build/workspace.cjs prepare shared-types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "node ../../scripts/workspace-build/workspace.cjs prepare shared-types",
    "test": "vitest run",
    "prebuild": "node ../../scripts/workspace-build/workspace.cjs prepare shared-types",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node dist/start.js",
    "ehr:start": "node openemr/start.cjs",
    "ehr:configure": "node openemr/configure.cjs",
    "test:browser": "node openemr/verify-browser.cjs",
    "test:ehr-guard": "node openemr/verify-seed-guard.cjs",
    "test:ig": "node test/fhir-ig/validate.mjs",
    "test:workflow": "node openemr/verify-workflow.cjs"
  },
  "dependencies": {
    "@telesphoros/shared-types": "workspace:*",
    "axios": "^1.20.0",
    "express": "^5.3.0",
    "jsonwebtoken": "9.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@eslint/js": "^10.0.1",
    "ajv": "8.20.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2",
    "jsdom": "^30.1.3",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
